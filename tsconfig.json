{
  "extends": "expo/tsconfig.base", // on étend la config de base Expo

  "compilerOptions": {
    "jsx": "react-native",
    "strict": true,
    "skipLibCheck": true, // ignore les .d.ts des modules (dont les erreurs jest)
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    "moduleResolution": "bundler",
    "types": ["jest"] // TypeScript 6 ne charge plus les @types globaux par défaut
  },

  "include": ["app/**/*.ts", "app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx"],

  "exclude": ["node_modules", "node_modules/expo-notifications/tsconfig.json"]
}
